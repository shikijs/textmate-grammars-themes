{
  "displayName": "Effekt",
  "foldingStartMarker": "(?<![\"'])(/\\*\\*|\\{\\s*$)",
  "foldingStopMarker": "(?<![\"'])(\\*\\*/|^\\s*})",
  "name": "effekt",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#regions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#boxed_types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#names"
    },
    {
      "include": "#holes"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "boxed_types": {
      "patterns": [
        {
          "begin": "\\b(at)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.at.effekt"
            }
          },
          "end": "}",
          "patterns": [
            {
              "include": "#capabilities"
            }
          ]
        },
        {
          "captures": {
            "1": {
              "name": "keyword.other.at.effekt"
            },
            "2": {
              "name": "variable.other.capability.effekt"
            }
          },
          "match": "\\b(at)\\s+([A-Za-z][0-9A-Z_a-z]*)",
          "patterns": [
            {
              "include": "#capabilities"
            }
          ]
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "match": "\\b(pure)\\b",
          "name": "keyword.other.capability.pure.effekt"
        },
        {
          "match": "\\b(io)\\b",
          "name": "support.constant.effekt variable.other.capability.effekt"
        },
        {
          "match": "\\b(global)\\b",
          "name": "support.constant.effekt variable.other.capability.effekt entity.name.region.effekt"
        },
        {
          "match": "\\b([a-z][0-9A-Z_a-z]*)\\b",
          "name": "variable.other.capability.effekt"
        },
        {
          "match": ",",
          "name": "punctuation.separator.capability.effekt"
        }
      ]
    },
    "characters": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.effekt",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#invalidEscapes"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "///",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.effekt"
            }
          },
          "end": "\\n",
          "name": "comment.line.documentation.effekt"
        },
        {
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.effekt"
            }
          },
          "end": "\\n",
          "name": "comment.line.double-slash.effekt"
        },
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.effekt"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.effekt"
            }
          },
          "name": "comment.block.effekt"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "begin": "\\s*(extern)\\s+(def)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.extern.effekt"
            },
            "2": {
              "name": "keyword.declaration.function.extern.effekt"
            },
            "3": {
              "name": "entity.name.function.effekt"
            }
          },
          "end": "(?=\\n)|(?<=\\S)\\s*(?==(?!>))",
          "patterns": [
            {
              "include": "#parameters"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#boxed_types"
            }
          ]
        },
        {
          "begin": "\\s*(def)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.effekt"
            },
            "2": {
              "name": "entity.name.function.effekt"
            }
          },
          "end": "(?=\\n)|(?<=\\S)\\s*(?==(?!>))",
          "patterns": [
            {
              "include": "#parameters"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#boxed_types"
            }
          ]
        },
        {
          "captures": {
            "1": {
              "name": "keyword.declaration.val.effekt"
            },
            "2": {
              "name": "variable.other.effekt"
            }
          },
          "match": "\\s*(val)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)"
        },
        {
          "begin": "\\s*(var)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.var.effekt"
            },
            "2": {
              "name": "variable.other.effekt"
            }
          },
          "end": ";|(?=\\n)|(?<=\\S)\\s*(?==(?!>))",
          "patterns": [
            {
              "captures": {
                "1": {
                  "name": "keyword.other.in.effekt"
                },
                "2": {
                  "patterns": [
                    {
                      "match": "global",
                      "name": "support.constant.effekt variable.other.capability.effekt entity.name.region.effekt"
                    },
                    {
                      "match": "[A-Za-z][!$0-9?A-Z_a-z]*",
                      "name": "variable.other.capability.effekt entity.name.region.effekt"
                    }
                  ]
                }
              },
              "match": "\\s+(in)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)"
            },
            {
              "include": "#parameters"
            }
          ]
        },
        {
          "captures": {
            "1": {
              "name": "storage.modifier.extern.effekt"
            },
            "2": {
              "name": "keyword.declaration.type.effekt"
            },
            "3": {
              "name": "entity.name.type.effekt"
            }
          },
          "match": "\\s*(extern)?\\s*(type|effect|interface|resource)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.declaration.namespace.effekt"
            },
            "2": {
              "name": "entity.name.namespace.effekt"
            }
          },
          "match": "\\s*(namespace)\\s+([A-Za-z][!$0-9?A-Z_a-z]*)"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.declaration.module.effekt"
            },
            "2": {
              "name": "entity.name.module.effekt"
            }
          },
          "match": "\\s*(module)\\s+([A-Za-z][0-9A-Z_a-z]*(?:/[A-Za-z][0-9A-Z_a-z]*)*)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.other.import.effekt"
            },
            "2": {
              "name": "entity.name.module.import.effekt"
            }
          },
          "match": "\\s*(import)\\s+([A-Za-z][0-9A-Z_a-z]*(?:/[A-Za-z][0-9A-Z_a-z]*)*)\\b"
        }
      ]
    },
    "escapes": {
      "match": "\\\\([\"$'\\\\bfnrt]|u\\h{4})",
      "name": "constant.character.escape.effekt"
    },
    "holeStrings": {
      "begin": "<\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.effekt"
        }
      },
      "end": "\">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.effekt"
        }
      },
      "name": "string.quoted.double.hole.effekt",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#invalidEscapes"
        },
        {
          "include": "#stringTemplates"
        }
      ]
    },
    "holes": {
      "begin": "<\\{",
      "end": "}>",
      "name": "meta.hole.effekt",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "invalidEscapes": {
      "match": "\\\\.",
      "name": "invalid.illegal.unknown-escape.effekt"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(module|import|def|fun|val|var|effect|type|record|box|unbox|region|new|resource|interface|namespace|include|export)\\b",
          "name": "keyword.other.effekt"
        },
        {
          "match": "\\b(return)\\b",
          "name": "keyword.control.jump.effekt"
        },
        {
          "match": "\\b(do|resume|try|with)\\b",
          "name": "keyword.control.effect.effekt"
        },
        {
          "match": "\\b(while|match|case|if|else|is|and|as)\\b",
          "name": "keyword.control.flow.effekt"
        },
        {
          "match": "\\b(extern)\\b",
          "name": "storage.modifier.extern.effekt"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.effekt"
        },
        {
          "match": "\\b([0-9]+\\.[0-9]+)\\b",
          "name": "constant.numeric.float.effekt"
        },
        {
          "match": "\\b([0-9]+)\\b",
          "name": "constant.numeric.integer.effekt"
        },
        {
          "match": "\\b0x(?:(?!\\h)|\\h(?!\\h)|\\h{3,}|\\H\\w*)",
          "name": "invalid.illegal.byte.effekt"
        },
        {
          "match": "\\b0x\\h{2}(?!\\h)",
          "name": "constant.numeric.byte.effekt"
        },
        {
          "include": "#characters"
        },
        {
          "include": "#holeStrings"
        },
        {
          "include": "#strings"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "match": "\\b[a-z][!$0-9?A-Z_a-z]*(?=\\s*[(\\[{])",
          "name": "entity.name.function.effekt"
        },
        {
          "match": "\\b[a-z][!$0-9?A-Z_a-z]*",
          "name": "variable.other.effekt"
        },
        {
          "match": "\\b[A-Z][!$0-9?A-Z_a-z]*",
          "name": "entity.name.type.effekt"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\|\\||&&",
          "name": "keyword.operator.logical.effekt"
        },
        {
          "match": "[-*+/:]=",
          "name": "keyword.operator.assignment.effekt"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arrow.effekt"
        },
        {
          "match": "\\.\\.\\.?|~>|<~",
          "name": "keyword.operator.range.effekt"
        },
        {
          "match": "\\+\\+|--",
          "name": "keyword.operator.concatenation.effekt"
        },
        {
          "match": "[!<=>]=",
          "name": "keyword.operator.comparison.effekt"
        },
        {
          "match": "<<|>>|\\^\\^",
          "name": "keyword.operator.arithmetic.effekt"
        },
        {
          "match": "::",
          "name": "keyword.operator.namespace.effekt"
        },
        {
          "match": "[<>]",
          "name": "keyword.operator.comparison.effekt"
        },
        {
          "match": "~",
          "name": "keyword.operator.range.effekt"
        },
        {
          "match": "[-*+/^]",
          "name": "keyword.operator.arithmetic.effekt"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.effekt"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "include": "#boxed_types"
        },
        {
          "match": "(?<![!$0-9?A-Z_a-z])\\?(?=[A-Z_a-z])",
          "name": "punctuation.definition.parameter.implicit.effekt"
        },
        {
          "match": "\\b[a-z][!$0-9?A-Z_a-z]*",
          "name": "variable.parameter.effekt"
        },
        {
          "match": "\\b[A-Z][!$0-9?A-Z_a-z]*",
          "name": "entity.name.type.effekt"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[](),;\\[{}]",
          "name": "punctuation.separator.effekt"
        }
      ]
    },
    "regions": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.other.region.effekt"
            },
            "2": {
              "name": "variable.other.capability.effekt entity.name.region.effekt"
            }
          },
          "match": "\\b(region)\\s+([A-Za-z][0-9A-Z_a-z]*)\\b"
        }
      ]
    },
    "shebang": {
      "patterns": [
        {
          "match": "\\A#!.*$",
          "name": "comment.line.shebang.effekt"
        }
      ]
    },
    "stringTemplates": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.effekt"
        }
      },
      "end": "}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.effekt"
        }
      },
      "name": "meta.embedded.line.effekt",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.effekt",
          "patterns": [
            {
              "include": "#stringTemplates"
            }
          ]
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.effekt"
            }
          },
          "end": "\"|(?=\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.effekt"
            }
          },
          "name": "string.quoted.double.effekt",
          "patterns": [
            {
              "match": "[^\"]*(?=\\n)",
              "name": "invalid.illegal.unterminated-string.effekt"
            },
            {
              "include": "#escapes"
            },
            {
              "include": "#invalidEscapes"
            },
            {
              "include": "#stringTemplates"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.effekt"
}
