{
  "bg": "#ffffff",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBlue": "#0031a9",
    "terminal.ansiBrightBlack": "#595959",
    "terminal.ansiBrightBlue": "#3548cf",
    "terminal.ansiBrightCyan": "#005f5f",
    "terminal.ansiBrightGreen": "#00663f",
    "terminal.ansiBrightMagenta": "#531ab6",
    "terminal.ansiBrightRed": "#972500",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#884900",
    "terminal.ansiCyan": "#005e8b",
    "terminal.ansiGreen": "#006800",
    "terminal.ansiMagenta": "#721045",
    "terminal.ansiRed": "#a60000",
    "terminal.ansiWhite": "#a6a6a6",
    "terminal.ansiYellow": "#6f5500"
  },
  "displayName": "Modus Operandi",
  "fg": "#000000",
  "name": "modus-operandi",
  "tokenColors": [
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#595959"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2a5045"
      }
    },
    {
      "scope": [
        "comment keyword.codetag.notation",
        "comment keyword.documentation"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a60000"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3548cf"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#00663f"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#0000b0"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#531ab6"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#a0132f"
      }
    },
    {
      "scope": [
        "support.constant",
        "support.function.builtin",
        "support.type.primitive",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8f0075"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7b435c"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2f3f83"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#005e8b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.property-name",
        "support.type.property-name",
        "variable.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#005e8b"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#005f5f"
      }
    },
    {
      "scope": [
        "entity.name.module",
        "entity.name.namespace",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#7a4f2f"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8f0075"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#005f5f"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#624416"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#193668"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#721045"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a5045"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7f0000"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#3548cf"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#005f5f"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#193668"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#006700"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#aa2222"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#655000"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a60000"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#884900"
      }
    }
  ],
  "type": "light"
}
