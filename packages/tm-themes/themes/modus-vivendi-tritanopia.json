{
  "bg": "#000000",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#ffffff",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBlue": "#2fafff",
    "terminal.ansiBrightBlack": "#595959",
    "terminal.ansiBrightBlue": "#79a8ff",
    "terminal.ansiBrightCyan": "#6ae4b9",
    "terminal.ansiBrightGreen": "#00c06f",
    "terminal.ansiBrightMagenta": "#b6a0ff",
    "terminal.ansiBrightRed": "#ff6740",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#ffa00f",
    "terminal.ansiCyan": "#00d3d0",
    "terminal.ansiGreen": "#44bc44",
    "terminal.ansiMagenta": "#feacd0",
    "terminal.ansiRed": "#ff5f59",
    "terminal.ansiWhite": "#a6a6a6",
    "terminal.ansiYellow": "#cabf00"
  },
  "displayName": "Modus Vivendi Tritanopia",
  "fg": "#ffffff",
  "name": "modus-vivendi-tritanopia",
  "tokenColors": [
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff9070"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a0d7f2"
      }
    },
    {
      "scope": [
        "comment keyword.codetag.notation",
        "comment keyword.documentation"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff5f59"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#ff5f59"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#88ca9f"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff7f86"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#ff6740"
      }
    },
    {
      "scope": [
        "support.constant",
        "support.function.builtin",
        "support.type.primitive",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#feacd0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#4ae2ff"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9099d9"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#76afbf"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.property-name",
        "support.type.property-name",
        "variable.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#79a8ff"
      }
    },
    {
      "scope": [
        "entity.name.module",
        "entity.name.namespace",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#ff9070"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#feacd0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4ae2ff"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6ae4b9"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff9070"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7fdbdf"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#feacd0"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#88ca9f"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#caa6df"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#00d3d0"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#a0d7f2"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#50c0ef"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff9095"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#cf9fe2"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff6740"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#feacd0"
      }
    }
  ],
  "type": "dark"
}
